{
  "name": "@webship.co/workspace-docusaurus",
  "version": "1.0.1",
  "description": "Docusaurus for Webship Workspace: the builder (`cmd-docusaurus-project.sh`, a documentation site made with create-docusaurus, the classic template in TypeScript, with versions of its docs, a second language, the local search or the step pack's whole test content, built for production and served in a container) and the CLI tool in every sites folder, the Docusaurus step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-docusaurus.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "workspacePlugin": {
    "name": "docusaurus",
    "label": "Docusaurus",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-docusaurus-project.sh",
        "commands/cmd-tools-docusaurus-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-docusaurus.sh"
      ],
      "args": [
        "scripts/args/arg-docusaurus.sh",
        "scripts/args/arg-docusaurus-cli.sh"
      ],
      "machine": [
        "testing/site.feature",
        "testing/test-site.feature",
        "scripts/node/docusaurus-test-site.cts"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/docusaurus-site-builder.md",
        "ai/agents/docusaurus-tester.md"
      ],
      "skills": [
        "ai/skills/docusaurus-scenarios"
      ],
      "commands": [
        "ai/commands/docusaurus-test.md"
      ],
      "prompts": [
        "ai/prompts/docusaurus-build-and-test.md",
        "ai/prompts/docusaurus-scenarios-for-a-page.md"
      ]
    },
    "features": [
      "features/docusaurus.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
